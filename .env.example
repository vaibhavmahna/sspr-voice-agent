# Sandbox tenant app registration (Entra ID -> App registrations)
# Needs: UserAuthMethod-Email.Read.All, UserAuthMethod-Phone.Read.All,
# UserAuthenticationMethod.ReadWrite.All, User-PasswordProfile.ReadWrite.All
# (Application permissions, admin consent granted), plus the Password
# Administrator directory role assigned to this app's service principal.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Azure OpenAI - judgment layer (added once the LLM piece is wired in)
# Auth is via DefaultAzureCredential (az login session), no key needed
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Separate app registration for sending the TAP notification email
# (Mail.Send, scoped via an Exchange Application Access Policy to one
# mailbox only)
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_MAILBOX=
